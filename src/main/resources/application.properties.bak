#spring.profiles.active=local

#CONFIGURACION  CONTENEDORA
server.port=8080
server.hostname=SLX00011239.eroski.es
spring.application.name=MisionGates
#spring.security.user.password=n/a
management.endpoint.health.show-details=always
#### Mostrar todos los endpoint por web
management.endpoints.web.exposure.include=*
management.endpoint.logfile.external-file=/home/umgates/datos/log/MisionGatesApplication.log
management.endpoints.jmx.exposure.include=*
# PARAMETROS DE CONFIGURACION SPRING BOOT ADMIN SERVER
#### URL servidor Spring boot admin
spring.boot.admin.client.url=http://springbootadmin.eroski.es:9000
spring.boot.admin.client.instance.name=MisionGates-PROD
spring.boot.admin.client.instance.service-url=http://${server.hostname}:${server.port}/swagger-ui.html
spring.boot.admin.client.instance.management-url=http://${server.hostname}:${server.port}/actuator
spring.boot.admin.client.instance.health-url=http://${server.hostname}:${server.port}/actuator/health
# En memoria

spring.datasource.url=jdbc:postgresql://${DBHOST2}:${DBPORT2}/${DBNAME2}?currentSchema=sumgates
spring.datasource.username=${DBUSER2}
spring.datasource.password=${DBPASS2}
spring.datasource.driver-class-name=org.postgresql.Driver

sic.spring.datasource.jdbcUrl=jdbc:oracle:thin:@${DBTNS_CONN_STRING}
sic.spring.datasource.username=${DBUSER}
sic.spring.datasource.password=${DBPASS}
sic.spring.datasource.driver-class-name=oracle.jdbc.OracleDriver

sia.spring.datasource.jdbcUrl=jdbc:oracle:thin:@${DBTNS_CONN_STRING3}
sia.spring.datasource.username=${DBUSER3}
sia.spring.datasource.password=${DBPASS3}
sia.spring.datasource.driver-class-name=oracle.jdbc.OracleDriver

kosmos.spring.datasource.jdbcUrl=jdbc:oracle:thin:@${DBTNS_CONN_STRING4}
kosmos.spring.datasource.username=${DBUSER4}
kosmos.spring.datasource.password=${DBPASS4}
kosmos.spring.datasource.driver-class-name=oracle.jdbc.OracleDriver

##spring.jpa.database-platform = org.hibernate.dialect.PostgreSQLDialect
## Duplicate spring.jpa.show-sql = true

spring.jpa.open-in-view=false
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
# App Properties
es.eroski.misiongates.jwtCookieName= eroski-jwt
es.eroski.misiongates.jwtRefreshCookieName= eroski-jwt-refresh
es.eroski.misiongates.jwtSecret= Er0sk1Er0sk1SecretKey
### Cada cuanto expira el token de usuario
es.eroski.misiongates.jwtExpirationMs= 600000
### El token de refresco define el tiempo de session maxima de usuario
es.eroski.misiongates.jwtRefreshExpirationMs= 1800000
###
spring.banner.location=custom-banner.txt
spring.jpa.properties.hibernate.enable_lazy_load_no_trans=true

### Url
### Url de los clientes. Las urls o dominios desde los que se puede invocar la API.
#cors.client.url = http://localhost:4200
cors.originPatterns = *
#### Contexto para aplicacion angular embebida
spring.mvc.pathmatch.matching-strategy=ANT_PATH_MATCHER
angular.app.context=mgates-frontend

### Configuracion para el servicio de correo
spring.mail.host = gtinet.eroski.es
spring.mail.properties.mail.transport.protocol = smtp
spring.mail.username = gates@eroski.es
spring.mail.port = 25
spring.mail.properties.mail.smtp.auth = false
spring.mail.properties.mail.smtp.starttls.enable= true

spring.jackson.time-zone=Europe/Madrid

#Propiedades para el csrf token

# Dominio valido para CSRF
csrf.domain=eroski.es
# Samesite en cookies strict,lax,none
cookies.samesite=lax
# Cookies seguras - true or false
cookies.setsecure=false
site.host = https://gates.eroski.es/mgates-frontend






# Cors allowed url
cors.allowed-origin=https://gates.eroski.es
